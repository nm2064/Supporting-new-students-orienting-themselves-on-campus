# Runtime
LOG_LEVEL=INFO

# Model provider: nvidia | azure | openai (default: azure if USE_AZURE_OPENAI=true, else openai)
# Production uses NVIDIA's hosted models:
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-your-key-here
# CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
# Changing EMBEDDING_MODEL requires rebuilding the Chroma index into a new directory.

# API Keys
OPENAI_API_KEY=sk-your-openai-key-here
AZURE_OPENAI_API_KEY=

# OpenAI Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
TRANSLATION_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1200
# Reasoning effort for reasoning models such as gpt-6-luna (none|low|medium|high).
CHAT_REASONING_EFFORT=low
# Output budget for grounded answers; thorough answers need room.
ANSWER_MAX_TOKENS=3000
LANGUAGE_DETECTION_CONFIDENCE_THRESHOLD=0.9

# Chunking Configuration
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# Retrieval Configuration
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Azure OpenAI Configuration (optional)
USE_AZURE_OPENAI=true
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment

# Vector Store
CHROMA_PERSIST_DIR=./chroma_store
KNOWLEDGE_FILE=./knowledge_extracted_pages.json

# Maps + Navigation
MAPS_DATA_FILE=./data/campus_places.json
ORS_API_KEY=your-openrouteservice-key-here
ORS_BASE_URL=https://api.openrouteservice.org
MAP_ROUTE_TIMEOUT_S=8
MAP_CACHE_TTL_S=300
MAP_CACHE_MAX_ITEMS=1000
MAP_RATE_LIMIT_ROUTE_PER_MIN=30
MAP_RATE_LIMIT_PLACES_PER_MIN=60
MAP_ENABLE_TRANSLATION_FALLBACK=true
